# WirePlumber session manager — runs alongside pipewire-session.service

[Unit]
Description=WirePlumber Session Manager (weston)
After=pipewire-session.service
BindsTo=pipewire-session.service

[Service]
Type=simple
User=weston
SupplementaryGroups=audio
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/wireplumber
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
