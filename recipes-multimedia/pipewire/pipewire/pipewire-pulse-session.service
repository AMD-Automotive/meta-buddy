# PipeWire Pulse-compatible server — runs alongside pipewire-session.service
# Provides the PulseAudio socket so pactl/paplay/Chromium PA backend work.

[Unit]
Description=PipeWire PulseAudio Compat (weston)
After=pipewire-session.service
BindsTo=pipewire-session.service

[Service]
Type=simple
User=weston
SupplementaryGroups=audio
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/pipewire-pulse
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
