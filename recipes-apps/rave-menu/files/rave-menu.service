[Unit]
Description=RAVE2 Menu Backend (Flask)
After=network.target rave-storage.service
Wants=network.target rave-storage.service

[Service]
Type=simple
WorkingDirectory=/opt/rave-menu
ExecStart=/usr/bin/python3 /opt/rave-menu/app.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target