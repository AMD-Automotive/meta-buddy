# Base template. apply_localization.py renders this plus a generated
# [keyboard] block to /run/rave-menu/weston.ini, which is what Weston loads.
# Do not add a [keyboard] section here; it would be stripped on render.

[core]
idle-time=0
shell=kiosk-shell.so

[autolaunch]
path=/usr/bin/rave-cog-launch.sh
watch=true
