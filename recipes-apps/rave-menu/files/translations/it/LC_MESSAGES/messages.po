msgstr "Avanzate"

#: templates/_versal_lab.html
msgid "Program Individual Partitions"
msgstr "Programma singole partizioni"

#: templates/system_update.html
msgid "Support Logs"
msgstr "Registri di supporto"

#: templates/system_update.html
msgid "A record of what has been programmed, installed and changed on this board. Logs are kept on this machine only. They are never uploaded or shared unless you download them and send them yourself."
msgstr "Un resoconto di ciò che è stato programmato, installato e modificato su questa scheda. I registri restano solo su questa macchina. Non vengono mai caricati né condivisi, a meno che non siate voi a scaricarli e inviarli."

#: templates/system_update.html
msgid "Record support logs"
msgstr "Registra i log di supporto"

#: templates/system_update.html
msgid "Download support archive"
msgstr "Scarica l'archivio di supporto"

#: i18n_strings.py
msgid "No entries yet."
msgstr "Ancora nessuna voce."

#: i18n_strings.py
msgid "{n} entries"
msgstr "{n} voci"

#: i18n_strings.py
msgid "last entry"
msgstr "ultima voce"

#: i18n_strings.py
msgid "Could not read the support log status."
msgstr "Impossibile leggere lo stato dei registri di supporto."

#: i18n_strings.py
msgid "Could not change the setting."
msgstr "Impossibile modificare l'impostazione."

#: i18n_strings.py
msgid "Recording is off."
msgstr "La registrazione è disattivata."

#: i18n_strings.py
msgid "Logging stopped: "
msgstr "Registrazione interrotta: "

#: i18n_strings.py
msgid "Persistent storage is unavailable, so these logs will not survive a system update."
msgstr "L'archiviazione persistente non è disponibile, quindi questi registri non sopravvivranno a un aggiornamento di sistema."

#: templates/index.html
msgid "System / Updates / Logs"
msgstr "Sistema / Aggiornamenti / Registri"

#: templates/_versal_lab.html
msgid "Warning: these options are experimental and may cause data loss. Ensure logging is enabled and use at your own risk."
msgstr "Avviso: queste opzioni sono sperimentali e possono causare perdita di dati. Assicurarsi che la registrazione sia attiva e usarle a proprio rischio."
