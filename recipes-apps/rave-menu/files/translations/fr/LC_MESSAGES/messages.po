#: i18n_strings.py
msgid "Mark this LUN as a UFS boot LUN. Optional: the Versal boots from OSPI and does not use them."
msgstr "Marquer ce LUN comme LUN d'amorçage UFS. Facultatif : le Versal démarre depuis l'OSPI et ne les utilise pas."

#: i18n_strings.py
msgid "Overwrite UFS Layout"
msgstr "Écraser la disposition UFS"

#: i18n_strings.py
msgid "Reset"
msgstr "Réinitialiser"

#: i18n_strings.py
msgid "BOOT"
msgstr "AMORÇAGE"

#: i18n_strings.py
msgid "remainder"
msgstr "reste"

#: i18n_strings.py
msgid "remainder assigned"
msgstr "reste attribué"

#: i18n_strings.py
msgid "unallocated"
msgstr "non alloué"

#: i18n_strings.py
msgid "nothing left for the remainder LUN"
msgstr "il ne reste rien pour le LUN de reste"

#: i18n_strings.py
msgid "over capacity by "
msgstr "capacité dépassée de "

#: i18n_strings.py
msgid "used"
msgstr "utilisé"

#: i18n_strings.py
msgid "Tick \"used\" to bring the next LUN into service. Sizes snap to whole allocation units; mark one LUN as \"remainder\" to give it whatever capacity is left. \"boot\" marks a UFS boot LUN: at most two exist, and they are optional because the Versal boots from OSPI."
msgstr "Cochez « utilisé » pour mettre le LUN suivant en service. Les tailles sont arrondies à des unités d'allocation entières ; marquez un LUN comme « reste » pour lui attribuer la capacité restante. « amorçage » désigne un LUN d'amorçage UFS : il en existe deux au maximum, et ils sont facultatifs car le Versal démarre depuis l'OSPI."

#: i18n_strings.py
msgid "New layout:"
msgstr "Nouvelle disposition :"

#: i18n_strings.py
msgid "Current Layout"
msgstr "Disposition actuelle"

#: templates/_versal_lab.html
msgid "Erase before programming (recommended when changing image)"
msgstr "Effacer avant la programmation (recommandé en cas de changement d'image)"

#: templates/_versal_lab.html
msgid "Erases only the region being programmed, then writes the image over it. Takes a few seconds on UFS."
msgstr "N'efface que la région programmée, puis y écrit l'image. Prend quelques secondes sur UFS."

